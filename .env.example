# Database
# Local zero-config default: SQLite
DATABASE_URL=sqlite:///data/competitive_intelligence.db

# Docker Compose PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://competitive:competitive@db:5432/competitive

# Collection
COLLECTION_TIMEOUT_SECONDS=25
COLLECTION_DELAY_SECONDS=2
USE_PLAYWRIGHT_FALLBACK=true
ROBOTS_POLICY=warn
USER_AGENT=Mozilla/5.0 (compatible; CompetitiveIntelligenceAgent/1.0; portfolio research)

# AI Agent (optional, required only for the AI Market Analyst)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Public AI analyst safeguards
AI_MAX_QUESTION_CHARS=500
AI_MAX_COMPLETION_TOKENS=900
AI_MAX_STEPS=3
AI_MAX_TOOL_CALLS=5
AI_MAX_TOOL_RESULT_CHARS=10000
AI_CACHE_TTL_SECONDS=3600
AI_MIN_REQUEST_INTERVAL_SECONDS=8
AI_MAX_SESSION_MESSAGES=12
AI_GROQ_TIMEOUT_SECONDS=25

# Dashboard
DASHBOARD_TITLE=Competitive Intelligence

# Retry / resilience
# Total attempts, including the first request.
HTTP_MAX_ATTEMPTS=3
PLAYWRIGHT_MAX_ATTEMPTS=2
RETRY_BACKOFF_BASE_SECONDS=1.5
RETRY_BACKOFF_MAX_SECONDS=12
RETRY_JITTER_SECONDS=0.5
